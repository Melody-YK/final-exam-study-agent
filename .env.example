APP_MODE=local
ALLOWED_HOSTS=[]
ALLOWED_ORIGINS=[]
DATABASE_URL=postgresql+asyncpg://study_agent@127.0.0.1:54329/study_agent
LOCAL_STORAGE_ROOT=.local/storage
LEXICAL_INDEX_ROOT=.local/lexical
COURSE_TERMS=[]

EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://router.tumuer.me/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
INDEX_RUNNER_POLL_SECONDS=1

CHAT_PROVIDER=deepseek
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
CHAT_STREAM=true

PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=0.5
PROVIDER_RETRY_MAX_SECONDS=8
PROVIDER_MAX_RESPONSE_BYTES=8388608
PROVIDER_MAX_STREAM_EVENTS=4096
PROVIDER_MAX_STREAM_EVENT_BYTES=262144
PROVIDER_MAX_ANSWER_CHARS=1048576
QUERY_REQUESTS_PER_MINUTE=30
UPLOAD_REQUESTS_PER_MINUTE=60
# Active accounts and unexpired invitation reservations share this capacity (1-10000).
ACTIVE_ACCOUNT_CAPACITY=10

RERANKER_ENABLED=false
COMPLEX_PARSER_ENABLED=false
PARTIAL_READY_ENABLED=false
DEMO_LAB_ENABLED=true
SOFFICE_BIN=
WORKER_TOKEN=
WORKER_PRESENCE_TTL_SECONDS=45
WORKER_EXTERNAL_PROCESS_TIMEOUT_SECONDS=180
WORKER_MAX_INPUT_BYTES=104857600
WORKER_MAX_PAGES=2000
WORKER_PADDLE_PROFILE_BIN=
WORKER_PADDLE_MODEL_CACHE=
WORKER_COMPLEX_PARSER_ENABLED=false
# Optional structured fallback profile; models are downloaded only by explicit warmup.
WORKER_DOCLING_PROFILE_BIN=
WORKER_DOCLING_ARTIFACTS_ROOT=
# Optional self-hosted MinerU API; the web UI enables MinerU only after health succeeds.
WORKER_MINERU_BASE_URL=
WORKER_MINERU_TOKEN=
WORKER_MINERU_BACKEND=pipeline
